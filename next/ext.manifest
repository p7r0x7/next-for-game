name: "Next"

platforms:
    osx:
        context:
            flags: ["-O3", "-flto"]
            linkFlags: ["-flto"]

    win32:
        context:
            flags: ["-O3", "-flto"]
            linkFlags: ["-flto"]
            libs: ["bcrypt"]

    linux:
        context:
            flags: ["-O3", "-flto"]
            linkFlags: ["-flto"]
